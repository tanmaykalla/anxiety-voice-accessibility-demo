{
  "name": "anxiety-voice-accessibility-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Vocal Bridge voice accessibility demo for Adventures With Anxiety",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild src/vocalbridge-stt.entry.js --bundle --format=iife --global-name=VoiceRPGVocalBridgeBundle --outfile=vocalbridge-stt.js",
    "start": "npm run build && node --env-file=.env server.mjs",
    "test": "node --test test/*.test.cjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@vocalbridgeai/sdk": "^0.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=20"
  }
}
